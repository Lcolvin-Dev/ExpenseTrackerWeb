@{
    ViewData["Title"] = "Expense Tracker";
}

<div class="text-center">

    <h1 class="display-3">
        Welcome to Expense Tracker
    </h1>

    <p class="lead">
        Track spending, manage budgets, and stay organized.
    </p>

</div>

<hr />

<div class="row">

    <div class="col-md-6">

        <div class="card shadow p-4">

            <h3>Manage Expenses</h3>

            <p>
                View, edit, and organize your expenses.
            </p>

            <a asp-controller="Expenses"
                   asp-action="Index"
                   class="btn btn-primary">

                View Expenses

            </a>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card shadow p-4">

            <h3>Add New Expense</h3>

            <p>
                Add bills, groceries, subscriptions, and more.
            </p>

            <a asp-controller="Expenses"
                   asp-action="Create"
                   class="btn btn-success">

                Add Expense

            </a>

        </div>

    </div>

</div>
